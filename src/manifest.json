{
  "manifest_version": 3,
  "name": "ScrollPeak",
  "version": "0.1.0",
  "description": "A scrollbar minimap. Hover the scrollbar to see the whole page, magnify a section, click to jump.",
  "homepage_url": "https://github.com/sky-is-green/scrollpeak",
  "icons": {
    "16": "icons/scrollpeak-16.png",
    "32": "icons/scrollpeak-32.png",
    "48": "icons/scrollpeak-48.png",
    "96": "icons/scrollpeak-96.png",
    "128": "icons/scrollpeak-128.png"
  },
  "permissions": [
    "storage",
    "theme"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/vugluscr.standalone.js",
        "colour.js",
        "textmap.js",
        "rail.js",
        "magnifier.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_title": "ScrollPeak",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/scrollpeak-16.png",
      "32": "icons/scrollpeak-32.png"
    }
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "scrollpeak@sky-is-green.github.io",
      "strict_min_version": "146.0"
    }
  }
}
